# Database — Neon PostgreSQL
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Optional pooled connection for serverless
# DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Admin PIN (4 digits)
ADMIN_PIN="1740"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="tipshub"
R2_PUBLIC_URL="https://your-r2-public-url.r2.dev"

# Optional — restrict R2 endpoint override
# R2_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
